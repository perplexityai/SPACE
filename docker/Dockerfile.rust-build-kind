# Kind-only fixture: the in-repo intermediate-key broker the Kind
# credential-manager authority uses (space-kind-key-broker); no production
# image copies it.
COPY --from=build /workspace/target/release/space-mock-branching-key-provider-svc /artifacts/bin/space-mock-branching-key-provider-svc
