# Kind-only: every SPACE Rust binary from ONE cargo-chef cook and ONE build.
#
# docker/Dockerfile.rust-build-common — the CI/publish path — compiles each
# artifact set (worker, api, data-plane, cluster-controller) in its own stage,
# so a cold `tilt up` cooked the shared dependency graph four times and every
# source change recompiled the workspace crates four times, once per image.
# The dev cluster does not need per-set images: it needs the same binaries with
# the same cargo features, once. This file produces a single artifact image
# whose `/artifacts` layout is the union of the four production sets, so the
# unchanged production runtime Dockerfiles (Dockerfile.api, .data-plane,
# .cluster-controller, .worker) consume it through SPACE_RUST_BUILD_IMAGE.
#
# Same toolchain, same flags: the base is the production Dockerfile's own
# `chef-base` stage (built by the caller as SPACE_RUST_CHEF_IMAGE), the bin and
# feature lists below are the union of the production sets' lists, and the
# planner/build-context COPY sets match the production stages. Only LTO is off,
# as build-images.sh and the Tiltfile already chose for local images, and
# every crate's `test-hooks` feature is on so the test-only environment
# overrides the Kind charts set take effect (production images never enable it). Keep the
# lists in step with Dockerfile.rust-build-common when a set changes.
#
# Build (repo root context):
#   docker build -t space-rust-chef-base:local -f docker/Dockerfile.rust-build-common --target chef-base .
#   docker build -t space-grpc-health-probe:local -f docker/Dockerfile.rust-build-common --target grpc-health-probe-downloader .
#   docker build -t space-rust-build-kind:local -f docker/Dockerfile.rust-build-kind .

ARG SPACE_RUST_CHEF_IMAGE=space-rust-chef-base:local
ARG SPACE_GRPC_HEALTH_PROBE_IMAGE=space-grpc-health-probe:local

FROM ${SPACE_RUST_CHEF_IMAGE} AS planner

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo/config.toml .cargo/config.toml
COPY crates ./crates
COPY proto ./proto
COPY infra/space/identity/node-identities.sh infra/space/identity/node-identities.sh
COPY templates/firecracker/seed/rootfs-builder.sh templates/firecracker/seed/rootfs-builder.sh
COPY templates/firecracker/recipes/seed.toml templates/firecracker/recipes/code-runtime.toml templates/firecracker/recipes/

RUN cargo chef prepare --recipe-path recipe.json

FROM ${SPACE_RUST_CHEF_IMAGE} AS cook

ENV CARGO_PROFILE_RELEASE_LTO=false

COPY --from=planner /workspace/recipe.json recipe.json
COPY infra/space/identity/node-identities.sh infra/space/identity/node-identities.sh

# The union of the worker, api, data-plane and cluster-controller sets.
# space-runtime-supervisor-svc is cooked here but built by
# scripts/build-runtime-supervisor.sh below, as the production worker stage does.
