      --features "pplx-space-node-api-svc/otel,pplx-space-node-api-svc/datadog,pplx-space-node-api-svc/k8s,pplx-space-internal-api-svc/otel,pplx-space-internal-api-svc/datadog,pplx-space-internal-api-svc/k8s,pplx-space-node-ctl-svc/otel,pplx-space-node-ctl-svc/datadog,pplx-space-node-ctl-svc/kubernetes,pplx-space-node-mgr-svc/otel,pplx-space-node-mgr-svc/datadog,pplx-space-build-mgr-svc/otel,pplx-space-build-mgr-svc/datadog,pplx-space-runtime-supervisor-svc/otel,pplx-space-runtime-supervisor-svc/datadog,pplx-space-runtime-manager-svc/otel,pplx-space-runtime-manager-svc/datadog,pplx-space-sbxmgr-svc/otel,pplx-space-sbxmgr-svc/datadog,pplx-space-spaced-host-svc/otel,pplx-space-spaced-host-svc/datadog,pplx-space-net-gateway-svc/otel,pplx-space-net-gateway-svc/datadog,pplx-space-tmplmgr-svc/otel,pplx-space-tmplmgr-svc/datadog,pplx-space-volmgr-svc/otel,pplx-space-volmgr-svc/datadog,pplx-space-api-svc/otel,pplx-space-api-svc/datadog,pplx-space-api-svc/kubernetes,pplx-space-api-svc/federated-identity,pplx-space-data-plane-svc/otel,pplx-space-data-plane-svc/datadog,pplx-space-data-plane-svc/kubernetes,pplx-space-cluster-controller/otel,pplx-space-cluster-controller/datadog,pplx-space-spaced-guest-svc/test-hooks,pplx-space-node-mgr-svc/test-hooks,pplx-space-sbxmgr-svc/test-hooks,pplx-space-tmplmgr-svc/test-hooks,pplx-space-template-mgr/test-hooks,pplx-space-internal-api-server/test-hooks,pplx-space-credmgr/test-hooks,pplx-space-common-svc/test-hooks,pplx-space-spaced-guest-server/test-hooks,pplx-space-observability/test-hooks,pplx-space-cluster-controller-server/test-hooks,pplx-space-common-core/test-hooks,pplx-space-sbx-mgr/test-hooks,pplx-space-api/test-hooks,pplx-space-build-mgr-server/test-hooks,pplx-space-node-api-server/test-hooks,pplx-space-node-mgr/test-hooks" \
      --bin spaced \
      --bin spaced-svc \
      --bin space-buildmgr \
      --bin space-buildmgr-svc \
      --bin space-tmplmgr \
      --bin space-runtime-supervisor-svc \
      --bin space-rtmgr-svc \
      --bin space-rtmgr \
      --bin space-nodemgr-svc \
      --bin space-sbxmgr \
      --bin space-nodectl \
      --bin space-sbxmgr-svc \
      --bin space-spaced-host-svc \
      --bin space-netgtw-svc \
      --bin space-tmplmgr-svc \
      --bin space-volmgr \
      --bin space-credmgr-svc \
      --bin space-volmgr-svc \
      --bin space-node-api-svc \
      --bin space-internal-api-svc \
      --bin space-nodectl-svc \
      --bin space-db-migrator \
      --bin space-api-svc \
      --bin space-template-publish \
      --bin space-data-plane-svc \
      --bin space-cluster-controller

FROM cook AS build

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo/config.toml .cargo/config.toml
COPY crates ./crates
COPY proto ./proto
COPY db ./db
COPY infra/space/identity/node-identities.sh infra/space/identity/node-identities.sh
COPY templates/firecracker/seed/rootfs-builder.sh templates/firecracker/seed/rootfs-builder.sh
COPY templates/firecracker/recipes/seed.toml templates/firecracker/recipes/code-runtime.toml templates/firecracker/recipes/
COPY scripts/build-runtime-supervisor.sh scripts/build-runtime-supervisor.sh

RUN cargo build --locked --release \
      -F pplx-space-node-api-svc/otel,pplx-space-node-api-svc/datadog \
      -F pplx-space-node-api-svc/k8s \
      -F pplx-space-internal-api-svc/otel,pplx-space-internal-api-svc/datadog \
      -F pplx-space-internal-api-svc/k8s \
      -F pplx-space-node-ctl-svc/otel,pplx-space-node-ctl-svc/datadog \
      -F pplx-space-node-ctl-svc/kubernetes \
      -F pplx-space-node-mgr-svc/otel,pplx-space-node-mgr-svc/datadog \
      -F pplx-space-build-mgr-svc/otel,pplx-space-build-mgr-svc/datadog \
      -F pplx-space-runtime-manager-svc/otel,pplx-space-runtime-manager-svc/datadog \
      -F pplx-space-sbxmgr-svc/otel,pplx-space-sbxmgr-svc/datadog \
      -F pplx-space-spaced-host-svc/otel,pplx-space-spaced-host-svc/datadog \
      -F pplx-space-net-gateway-svc/otel,pplx-space-net-gateway-svc/datadog \
      -F pplx-space-tmplmgr-svc/otel,pplx-space-tmplmgr-svc/datadog \
      -F pplx-space-volmgr-svc/otel,pplx-space-volmgr-svc/datadog \
      -F pplx-space-api-svc/otel,pplx-space-api-svc/datadog \
      -F pplx-space-api-svc/kubernetes \
      -F pplx-space-api-svc/federated-identity \
      -F pplx-space-data-plane-svc/otel,pplx-space-data-plane-svc/datadog \
      -F pplx-space-data-plane-svc/kubernetes \
      -F pplx-space-cluster-controller/otel,pplx-space-cluster-controller/datadog \
      -F pplx-space-spaced-guest-svc/test-hooks,pplx-space-node-mgr-svc/test-hooks,pplx-space-sbxmgr-svc/test-hooks,pplx-space-tmplmgr-svc/test-hooks \
      -F pplx-space-template-mgr/test-hooks,pplx-space-internal-api-server/test-hooks,pplx-space-credmgr/test-hooks \
      -F pplx-space-common-svc/test-hooks,pplx-space-spaced-guest-server/test-hooks,pplx-space-observability/test-hooks \
      -F pplx-space-cluster-controller-server/test-hooks,pplx-space-common-core/test-hooks,pplx-space-sbx-mgr/test-hooks,pplx-space-api/test-hooks \
      -F pplx-space-build-mgr-server/test-hooks,pplx-space-node-api-server/test-hooks,pplx-space-node-mgr/test-hooks \
      --bin spaced \
      --bin spaced-svc \
      --bin space-buildmgr \
      --bin space-buildmgr-svc \
      --bin space-tmplmgr \
      --bin space-rtmgr-svc \
      --bin space-rtmgr \
      --bin space-nodemgr-svc \
      --bin space-sbxmgr \
      --bin space-nodectl \
      --bin space-sbxmgr-svc \
      --bin space-spaced-host-svc \
      --bin space-netgtw-svc \
      --bin space-tmplmgr-svc \
      --bin space-volmgr \
      --bin space-credmgr-svc \
      --bin space-volmgr-svc \
      --bin space-node-api-svc \
      --bin space-internal-api-svc \
      --bin space-nodectl-svc \
      --bin space-db-migrator \
      --bin space-api-svc \
      --bin space-template-publish \
      --bin space-data-plane-svc \
      --bin space-cluster-controller

RUN bash scripts/build-runtime-supervisor.sh \
      target/release/space-runtime-supervisor-svc \
      target/release/space-runtime-supervisor-compatibility \
      cargo build --locked --release \
        -F pplx-space-runtime-supervisor-svc/otel,pplx-space-runtime-supervisor-svc/datadog \
        --bin space-runtime-supervisor-svc

FROM ${SPACE_GRPC_HEALTH_PROBE_IMAGE} AS grpc-health-probe

