    && rm -rf /var/lib/apt/lists/*

FROM binary-downloader-base AS grpc-health-probe-downloader

ARG TARGETARCH
ARG GRPC_HEALTH_PROBE_VERSION=v0.4.48

RUN set -eux; \
      case "${TARGETARCH:-amd64}" in \
        amd64) asset=grpc_health_probe-linux-amd64; sha256=ceeacfc858929b223f90a823e7da46ab34605ec7c2a9ee1dd272fa9e4fedf5e6 ;; \
        arm64) asset=grpc_health_probe-linux-arm64; sha256=98792fd8c3356991735df46c8d1fe415d7825ff7a988ac2ba18159ed801097a4 ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}"; exit 1 ;; \
      esac; \
      curl -fsSL \
        "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/${asset}" \
        -o /grpc_health_probe; \
      printf '%s  %s\n' "${sha256}" /grpc_health_probe | sha256sum -c -; \
      chmod 0755 /grpc_health_probe

