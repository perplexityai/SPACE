# Runnable SPACE worker image for Kubernetes DaemonSet deployment.
#
# Contains node-manager, sandbox-manager, template-manager, and all host-side services
# plus the system tools they shell out to (ip, tc, nft, mount, btrfs, etc.).
#
# Application files live under /opt/space/ so they aren't shadowed by the
# host mount on /space/ (which provides runtime state: run, cache, vendor).
#
# Build:
#   docker build -f docker/Dockerfile.rust-build-common --target build-artifacts-worker -t space-rust-build-worker:local .
#   docker build -f docker/Dockerfile.worker -t space-worker:latest .

ARG SPACE_RUST_BUILD_IMAGE=space-rust-build-worker:local
ARG AWS_CLI_IMAGE=public.ecr.aws/aws-cli/aws-cli:2.27.41
FROM ${SPACE_RUST_BUILD_IMAGE} AS rust-build
FROM ${AWS_CLI_IMAGE} AS aws-cli

FROM public.ecr.aws/ubuntu/ubuntu:24.04 AS space-btrfs-progs
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY docker/build-btrfs-progs.sh /tmp/build-btrfs-progs.sh
RUN bash /tmp/build-btrfs-progs.sh

FROM public.ecr.aws/ubuntu/ubuntu:24.04 AS space-e2fsprogs
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc make libc6-dev curl ca-certificates xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --show-error --location --retry 5 \
      https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v1.47.4/e2fsprogs-1.47.4.tar.xz \
      -o /tmp/e2fsprogs.tar.xz \
    && echo 'fd5bf388cbdbe006a3d3b318d983b2948382440acc85a87f1e7d108653e8db0b  /tmp/e2fsprogs.tar.xz' | sha256sum -c - \
    && tar -C /tmp -xJf /tmp/e2fsprogs.tar.xz \
    && cd /tmp/e2fsprogs-1.47.4 \
    && ./configure --prefix=/opt/space/e2fsprogs --disable-elf-shlibs --disable-uuidd \
    && make -j"$(nproc)" \
    && make install

# The image up to its SPACE binaries: the dependency layers the Kind build cache
# keeps (infra/space/kind/scripts/runtime-image-cache.sh).
FROM public.ecr.aws/ubuntu/ubuntu:24.04 AS runtime-deps
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# SPACE groups — must match the host GIDs from the AMI's 07-sysctl.sh.
# Node-manager needs these for socket permissions (getgrnam). Volume-manager
# has its own UID and credential-socket group; runtime launchers select it.
COPY infra/space/identity/node-identities.sh /opt/space/etc/node-identities.sh
RUN . /opt/space/etc/node-identities.sh && \
    for spec in $SPACE_GROUP_SPECS; do \
      group="${spec%%:*}"; gid="${spec##*:}"; groupadd -g "$gid" "$group"; \
    done && \
    printf '%s\n' "$SPACE_USER_SPECS" | while IFS=: read -r _ user uid group; do \
      test -n "$user" || continue; \
      useradd --system --no-create-home --uid "$uid" --gid "$group" --shell /usr/sbin/nologin "$user"; \
      test "$(id -u "$user")" = "$uid"; \
      test "$(id -g "$user")" = "$(space_expected_gid_for_group "$group")"; \
    done && \
    test "$(getent group space-buildclients | cut -d: -f3)" = "$(space_expected_gid_for_group space-buildclients)" && \
    test "$(getent group space-sidecarclients | cut -d: -f3)" = "$(space_expected_gid_for_group space-sidecarclients)"

# System tools required by node-manager at runtime:
#   iproute2  - ip, tc (namespace, veth, tap, routes, arp, TC mirred)
#   nftables  - nft (firewall rules)
#   btrfs-progs - btrfs (CoW rootfs clones, snapshots)
#   util-linux - mount, umount, losetup (rootfs template injection)
#   procps    - sysctl (proxy_arp, ip_forward)
#   cryptsetup-bin, dmsetup - BYOK encrypted-rootfs (LUKS2 + dm-snapshot) in
#               node-mgr (which hosts the encrypted-volume delegation RPCs;
#               vol-mgr keeps a transitional copy until its privileged
#               deployment shape is retired). Inert unless BYOK is enabled.
#   kmod      - modprobe for the dm_crypt/dm_snapshot kernel modules; worker
#               kernels don't load them at boot, so the kernel-support
#               preflight loads them (needs the host /lib/modules mount the
#               BYOK-gated chart shape provides). Inert unless BYOK is enabled.
# Rootfs/snapshot page-cache reclamation is handled in node services with
# per-file fadvise hints; image-level vm.* sysctls are not applied by pods.
RUN apt-get update && apt-get install -y --no-install-recommends \
      containerd \
      e2fsprogs \
      iproute2 \
      nftables \
      btrfs-progs \
      openssh-client \
      sudo \
      util-linux \
      cryptsetup-bin \
      dmsetup \
      kmod \
      procps \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Link the filesystem libraries into these tools; retain the distro libraries
# used by unrelated tools such as mount, findmnt and btrfs.
COPY --from=space-e2fsprogs \
    /opt/space/e2fsprogs/sbin/e2fsck \
    /opt/space/e2fsprogs/sbin/resize2fs \
    /opt/space/e2fsprogs/sbin/dumpe2fs \
    /opt/space/e2fsprogs/sbin/tune2fs \
    /usr/local/sbin/
RUN test "$(command -v e2fsck)" = /usr/local/sbin/e2fsck && e2fsck -V

COPY --from=space-btrfs-progs /opt/space/btrfs-progs/btrfs /usr/local/sbin/btrfs
RUN test "$(command -v btrfs)" = /usr/local/sbin/btrfs \
    && test "$(btrfs --version | head -n 1)" = 'btrfs-progs v7.3' \
    && sha256sum /usr/local/sbin/btrfs

# node-manager init can stage an immutable, digest-pinned guest kernel from the
# cluster bootstrap bucket. Copy the authenticated AWS CLI from its pinned
# upstream image instead of relying on expiring presigned URLs.
COPY --from=aws-cli /usr/local/aws-cli /usr/local/aws-cli
RUN ln -s /usr/local/aws-cli/v2/current/bin/aws /usr/local/bin/aws

FROM runtime-deps

LABEL org.opencontainers.image.title="space-worker"
LABEL org.opencontainers.image.description="SPACE worker node services (node-manager + sandbox-manager)"

# SPACE binaries
# Guest spaced artifacts are packaged for seed image injection only; they are
# not host-facing executables and intentionally live outside /opt/space/bin.
COPY --from=rust-build /artifacts/bin/spaced               /opt/space/data/spaced/spaced
COPY --from=rust-build /artifacts/bin/spaced-svc           /opt/space/data/spaced/spaced-svc
COPY --from=rust-build /artifacts/bin/space-runtime-supervisor-svc /opt/space/bin/space-runtime-supervisor-svc
COPY --from=rust-build /artifacts/etc/space-runtime-supervisor-compatibility /opt/space/etc/space-runtime-supervisor-compatibility
COPY --from=rust-build /artifacts/bin/space-rtmgr-svc        /opt/space/bin/space-rtmgr-svc
COPY --from=rust-build /artifacts/bin/space-rtmgr            /opt/space/bin/space-rtmgr
COPY --from=rust-build /artifacts/bin/space-nodemgr-svc      /opt/space/bin/space-nodemgr-svc
COPY --from=rust-build /artifacts/bin/space-sbxmgr          /opt/space/bin/space-sbxmgr
COPY --from=rust-build /artifacts/bin/space-nodectl         /opt/space/bin/space-nodectl
COPY --from=rust-build /artifacts/bin/space-sbxmgr-svc       /opt/space/bin/space-sbxmgr-svc
COPY --from=rust-build /artifacts/bin/space-spaced-host-svc  /opt/space/bin/space-spaced-host-svc
COPY --from=rust-build /artifacts/bin/space-netgtw-svc       /opt/space/bin/space-netgtw-svc
COPY --from=rust-build /artifacts/bin/space-tmplmgr-svc      /opt/space/bin/space-tmplmgr-svc
COPY --from=rust-build /artifacts/bin/space-volmgr           /opt/space/bin/space-volmgr
COPY --from=rust-build /artifacts/bin/space-credmgr-svc      /opt/space/bin/space-credmgr-svc
COPY --from=rust-build /artifacts/bin/space-volmgr-svc       /opt/space/bin/space-volmgr-svc
COPY --from=rust-build /artifacts/bin/space-nodectl-svc      /opt/space/bin/space-nodectl-svc
COPY --from=rust-build /artifacts/bin/space-node-api-svc     /opt/space/bin/space-node-api-svc
COPY --from=rust-build /artifacts/bin/space-internal-api-svc  /opt/space/bin/space-internal-api-svc
COPY --from=rust-build /artifacts/bin/space-buildmgr         /opt/space/bin/space-buildmgr
COPY --from=rust-build /artifacts/bin/space-buildmgr-svc     /opt/space/bin/space-buildmgr-svc
COPY --from=rust-build /artifacts/bin/space-tmplmgr          /opt/space/bin/space-tmplmgr
COPY --from=rust-build /artifacts/bin/space-db-migrator     /opt/space/bin/space-db-migrator
COPY --from=rust-build /artifacts/bin/grpc_health_probe      /opt/space/bin/grpc_health_probe

# DB migrations + scripts
COPY --chmod=0755 scripts/space-sbx-db-migrate.sh /opt/space/bin/space-sbx-db-migrate.sh
COPY --chmod=0755 scripts/k8s/node-manager-init.sh /opt/space/bin/node-manager-init.sh
COPY --chmod=0755 scripts/k8s/node-manager-runtime-supervisor.sh /opt/space/bin/node-manager-runtime-supervisor.sh
COPY --chmod=0755 scripts/k8s/stage-guest-kernel.sh /opt/space/bin/stage-guest-kernel.sh
COPY --chmod=0755 scripts/k8s/sandbox-manager-start.sh /opt/space/bin/sandbox-manager-start.sh
COPY docker/space/nftables /etc/space/nftables
COPY templates/firecracker/recipes /opt/space/templates/firecracker/recipes

ARG SPACE_GIT_SHA=unknown
LABEL org.opencontainers.image.revision="${SPACE_GIT_SHA}"
RUN mkdir -p /etc/space && printf '%s\n' "${SPACE_GIT_SHA}" > /etc/space/build-git-sha

ENV PATH="/opt/space/bin:${PATH}"
