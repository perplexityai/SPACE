# Local kind node-stack image — the production worker image plus the kind
# entrypoint.
#
# The base is docker/Dockerfile.worker (the image the prod EKS worker
# DaemonSets run): same binaries, same cargo features, same unix identities,
# same nftables policies and recipes. This layer adds only what the kind
# harness needs on top:
#
#   * node-stack-start.sh — one pod stands in for a whole worker node, so a
#     single entrypoint supervises the full service set (prod runs one
#     DaemonSet per service); it also recreates the AMI-provided directory
#     skeleton/ownership and the btrfs cache filesystem (loopback here,
#     instance-store NVMe in prod).
#   * postgresql-client — ONLY for the legacy DirectSubstrate bench
#     registration (space-local-3486); the production-shaped path never
#     touches Postgres from a node.
#   * /space/bin symlinks — prod's node-manager-init.sh stages binaries onto
#     the host at /space/bin; in kind the pod fs stands in for the host, so
#     symlink the canonical paths at the image layer.
#
# No seed template is baked here. Workers obtain `seed` through the
# production template pull path (space-seed-publish Job → object store →
# ClusterApi.FindTemplateRelease → volume-manager PullFile).
#
# Build:
#   docker build -f docker/Dockerfile.rust-build-common --target build-artifacts-worker -t space-rust-build-worker:local .
#   docker build -f docker/Dockerfile.worker -t space-worker:local .
#   docker build -f docker/Dockerfile.node-stack --build-arg SPACE_WORKER_IMAGE=space-worker:local -t space-node-stack:local .

ARG SPACE_WORKER_IMAGE=space-worker:local
FROM ${SPACE_WORKER_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

LABEL org.opencontainers.image.title="space-node-stack"
LABEL org.opencontainers.image.description="SPACE local kind node-stack (production worker image + kind entrypoint)."

RUN apt-get update && apt-get install -y --no-install-recommends \
      postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# sandbox-manager launches /space/bin/space-spaced-host-svc by absolute path;
# in prod node-manager-init.sh stages the binaries onto the host /space/bin.
# The pod fs is the "host" here, so alias the canonical path to the image bin
# dir once.
RUN mkdir -p /space && ln -sfn /opt/space/bin /space/bin

# Firecracker assets are hostPath-mounted at runtime from the kind worker
# (which in turn extraMount-binds them from the devbox host's
# $SPACE_VENDOR_ROOT tree, ~/.space-devbox/space/vendor by default).
# Production uses the same
# layout: Packer populates /space/vendor/firecracker/<version> on the AMI.
# Symlink /space/bin/firecracker (and jailer) onto the mounted `default` so
# the binary is on the same canonical path as prod. These symlinks dangle
# until the chart mounts the volume at runtime.
RUN ln -sfn /space/vendor/firecracker/default/bin/firecracker /space/bin/firecracker \
 && ln -sfn /space/vendor/firecracker/default/bin/jailer /space/bin/jailer

COPY --chmod=0755 scripts/k8s/node-stack-start.sh /opt/space/bin/node-stack-start.sh
COPY --chmod=0755 scripts/k8s/stage-guest-kernel.sh /opt/space/bin/stage-guest-kernel.sh
# Sourced by the entrypoint, next to node-identities.sh (which Dockerfile.worker
# stages the same way): the pod has to build its own loop-device pool because
# its /dev is a snapshot of the kind node's, and both the btrfs cache mount and
# every encrypted sandbox allocate from it.
COPY --chmod=0644 scripts/lib/space-loop-devices.sh /opt/space/etc/space-loop-devices.sh

ENV PATH="/opt/space/bin:${PATH}"

ENTRYPOINT ["/opt/space/bin/node-stack-start.sh"]
