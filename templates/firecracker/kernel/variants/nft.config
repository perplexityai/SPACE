# nft: nf_tables plus complete legacy iptables, built in.
#
# The Firecracker CI base config has no nf_tables, no raw table and no state
# match. Distribution iptables 1.8.x defaults to the nf_tables backend, so
# images that run `iptables` or `nft` fail on the base kernel. This fragment
# adds the nf_tables families and expressions that iptables-nft, nft and
# Docker's bridge networking use, and fills the gaps in legacy iptables.
# CONFIG_MODULES stays unset: every symbol here is built in.
# nft.disabled lists what this variant deliberately leaves out.

# nf_tables core, the ip/ip6/inet families and the expressions iptables-nft
# needs (conntrack state, xtables compatibility, reject).
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_REJECT=y

# NAT, masquerade and redirect for container bridge networks, plus fib
# lookups, rate limits and logging.
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y

# Legacy iptables: the raw table and the state match.
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MATCH_STATE=y

# Common xtables extensions, used through either backend.
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
