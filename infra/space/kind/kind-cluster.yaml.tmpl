# Template for the `space-local` kind cluster config. Not consumable by
# `kind create` as it stands: the `${...}` host paths are substituted by
# `infra/space/kind/scripts/lib/kind-host-paths.sh`, which writes the result to
# $SPACE_KIND_CONFIG (default ~/.space-devbox/kind/kind-cluster.yaml) and is
# what both bring-up paths — `scripts/bootstrap.sh` and the smoke suites'
# `scripts/tests/lib/bootstrap-kind-stack.sh` — pass to `kind create`.
#
# The host paths are rendered rather than written here because `kind create`
# expands nothing, so a literal path would name one machine's layout: these
# trees live under the invoking user's home, and hardcoding `/home/dev` gave
# every other username an empty `/space/vendor` and a first sandbox that died
# looking like a Firecracker fault. Nothing refused the missing path —
# `kind create` accepts an extraMount hostPath that does not exist, and Docker
# creates it.
#
# The knobs, named without braces on purpose: a braced placeholder in a
# comment gets substituted like any other, and this block would render as
# "/home/you/.kind-data default ~/.kind-data".
#   SPACE_KIND_DATA_ROOT  default ~/.kind-data
#   SPACE_VENDOR_ROOT     default ~/.space-devbox/space/vendor
#   SPACE_KIND_NODE_IMAGE default: the content-addressed SPACE node image
#                         (scripts/kind-node-image.sh ref)
#   SPACE_KIND_BASE_NODE_IMAGE the kindest/node that image is built FROM
#                         (scripts/kind-node-image.sh base)
#
# Node images: sandbox workers and builders run the SPACE Kind node image
# (node/Dockerfile), which bakes in the node layer a production worker's or
# builder's node image provides — btrfs /space/cache, cgroup subtree, loop
# devices, device permissions, /space skeleton — as units that run before
# kubelet on every boot. The control-plane and infra nodes run its pinned base
# unchanged, as production's non-SPACE nodes have no SPACE node layer. One base,
# so every node runs the same Kubernetes version. Bring-up runs
# `kind-node-image.sh ensure` before `kind create`.
#
# Both defaults reproduce the paths this file used to hardcode when $HOME is
# /home/dev, so a devbox renders byte-identical mounts.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: space-local
nodes:
  - role: control-plane
    image: ${SPACE_KIND_BASE_NODE_IMAGE}
    # /var/lib/containerd is where the kind worker's containerd stores image
    # blobs + snapshotter state. The image set can exhaust the per-container
    # overlay during `kind load`. Mount it from a per-node host directory so
    # each kind worker can use the host filesystem capacity.
    # `kind_prepare_host_mounts` pre-creates
    # every dir under SPACE_KIND_DATA_ROOT before `kind create`, reading
    # this file rather than a second list of node roles.
    extraMounts:
      - hostPath: ${SPACE_KIND_DATA_ROOT}/control-plane/containerd
        containerPath: /var/lib/containerd
  # Sandbox worker nodes — receive SPACE sandbox pods. Labeled
  # node.kubernetes.io/space-enabled=true by the bootstrap step.
  # Do NOT run control-plane components here; these nodes get drained
  # and terminated during node-drain e2e tests.
  #
  # extraMounts on sandbox workers:
  #   - SPACE_VENDOR_ROOT : where install-fc-vendor.sh stages
  #     Firecracker v1.15.1 (binary, jailer,
  #     vmlinux). The host runtime-supervisor and the node services read
  #     /space/vendor from the node, matching production where
  #     /space/vendor is populated by Packer on the AMI. Without this the
  #     worker image would have to bake the FC tree itself.
  #   - /dev/kvm : Firecracker needs the host KVM character device. kind
  #     nodes run as privileged docker containers; bind-mounting the device
  #     file lets the container's /dev/kvm work.
  - role: worker
    image: ${SPACE_KIND_NODE_IMAGE}
    labels:
      space.pplx.net/node-pool: sandbox
    extraMounts:
      - hostPath: ${SPACE_KIND_DATA_ROOT}/worker1/containerd
        containerPath: /var/lib/containerd
      - hostPath: ${SPACE_VENDOR_ROOT}
        containerPath: /space/vendor
        readOnly: true
      - hostPath: /dev/kvm
        containerPath: /dev/kvm
  - role: worker
    image: ${SPACE_KIND_NODE_IMAGE}
    labels:
      space.pplx.net/node-pool: sandbox
    extraMounts:
      - hostPath: ${SPACE_KIND_DATA_ROOT}/worker2/containerd
        containerPath: /var/lib/containerd
      - hostPath: ${SPACE_VENDOR_ROOT}
        containerPath: /space/vendor
        readOnly: true
      - hostPath: /dev/kvm
        containerPath: /dev/kvm
  # Infra node — runs Postgres, space-api, and space-cluster-controller.
  # Never labeled space-enabled so sandbox pods never land here, and
  # never targeted by the drain reconciler.
  #
  # extraPortMappings: the load-balanced entry. The host's 127.0.0.1:8080 and
  # :8090 reach the space-api-entry and space-data-plane-entry NodePort
  # Services, and kube-proxy spreads each connection across the replicas, as
  # a deployment's load balancer does; a `kubectl port-forward` pins every
  # request to one pod. On this node because it is never drained. Docker
  # fixes port mappings when it creates the node container, so a cluster
  # created without them is recreated (scripts/check-node-layout.sh).
  - role: worker
    image: ${SPACE_KIND_BASE_NODE_IMAGE}
    labels:
      space.pplx.net/node-pool: infra
    extraPortMappings:
      - containerPort: 30080
        hostPort: 8080
        listenAddress: 127.0.0.1
        protocol: TCP
      - containerPort: 30090
        hostPort: 8090
        listenAddress: 127.0.0.1
        protocol: TCP
    extraMounts:
      - hostPath: ${SPACE_KIND_DATA_ROOT}/worker3/containerd
        containerPath: /var/lib/containerd
  # Builder nodes — run the production-shaped builder node stack. They are kept
  # out of the sandbox placement pool: build VMs are created directly by the
  # builders' node-api/build-manager pairs, while user sandbox pods continue to
  # land only on the sandbox workers above.
  - role: worker
    image: ${SPACE_KIND_NODE_IMAGE}
    labels:
      space.pplx.net/node-pool: builder
    extraMounts:
      - hostPath: ${SPACE_KIND_DATA_ROOT}/builder/containerd
        containerPath: /var/lib/containerd
      - hostPath: ${SPACE_VENDOR_ROOT}
        containerPath: /space/vendor
        readOnly: true
      - hostPath: /dev/kvm
        containerPath: /dev/kvm
  - role: worker
    image: ${SPACE_KIND_NODE_IMAGE}
    labels:
      space.pplx.net/node-pool: builder
    extraMounts:
      - hostPath: ${SPACE_KIND_DATA_ROOT}/builder2/containerd
        containerPath: /var/lib/containerd
      - hostPath: ${SPACE_VENDOR_ROOT}
        containerPath: /space/vendor
        readOnly: true
      - hostPath: /dev/kvm
        containerPath: /dev/kvm
