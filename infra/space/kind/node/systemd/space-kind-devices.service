# Baked into the Kind node image (infra/space/kind/node/Dockerfile) and enabled
# there. See infra/space/kind/node/space-kind-node.sh.
[Unit]
Description=SPACE Kind-only KVM and vhost device permissions
Before=kubelet.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/space/kind-node.env
ExecStart=/usr/local/lib/space/kind-node/space-kind-node.sh devices

[Install]
WantedBy=multi-user.target
