# Installed on Kind SPACE nodes by infra/space/kind/scripts/prepare-kind-node.sh.
# See infra/space/kind/node/space-kind-node.sh.
[Unit]
Description=SPACE btrfs /space/cache on a loopback image
Wants=space-loop-nodes.service
After=local-fs.target space-loop-nodes.service
Before=kubelet.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/space/kind-node.env
ExecStart=/usr/local/lib/space/kind-node/space-kind-node.sh cache

[Install]
WantedBy=multi-user.target
