# Installed on Kind SPACE nodes by infra/space/kind/scripts/prepare-kind-node.sh.
# See infra/space/kind/node/space-kind-node.sh.
[Unit]
Description=SPACE loop-device node headroom
Before=kubelet.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/space/kind-node.env
ExecStart=/usr/local/lib/space/kind-node/space-kind-node.sh loop-nodes

[Install]
WantedBy=multi-user.target
