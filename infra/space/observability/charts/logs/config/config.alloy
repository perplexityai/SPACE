logging {
  level = "info"
  format = "json"
}
{{ if .Values.collection.podTargets }}
// Read only the configured SPACE pod logs; never collect Alloy's own output.
local.file_match "pods" {
  sync_period = "2s"
  path_targets = [
{{- range .Values.collection.podTargets }}
    {__path__ = {{ .path | quote }}, namespace = {{ .namespace | quote }}},
{{- end }}
  ]
}
// Filter resolved source paths, including matches from overlapping globs.
// Excluded containers never reach a file reader or diagnostic echo.
discovery.relabel "eligible_pods" {
  targets = local.file_match.pods.targets
{{- range .Values.collection.excludedPodSources }}
  rule {
    source_labels = ["__path__"]
    regex = {{ printf ".*/%s_%s[^/]*_[^/]+/%s/[^/]+" (regexQuoteMeta .namespace) (regexQuoteMeta .podNamePrefix) (regexQuoteMeta .container) | quote }}
    action = "drop"
  }
{{- end }}
  // Plain-text output, such as an init container's, has no JSON `service`.
  // Name such a stream after its container, in the form SPACE services use,
  // so every stream has one; a line's own JSON `service` replaces it below.
  rule {
    source_labels = ["__path__"]
    regex = ".*/[^/]+/(?:space-)?([^/]+)/[^/]+"
    target_label = "service"
    replacement = "space-$1"
  }
}
loki.source.file "pods" {
  targets = discovery.relabel.eligible_pods.output
  forward_to = [loki.process.cri.receiver]
}
loki.process "cri" {
  stage.cri {}
  // The transport is `log_source`, not `source`: SPACE JSON lines carry their
  // own `source` field, which a stream label of that name would shadow.
  stage.static_labels {
    values = {log_source = "container", node = sys.env("NODE_NAME"), cluster = {{ .Values.clusterLabel | quote }}}
  }
  // Transport identity is searchable metadata, not an indexed stream label.
  stage.structured_metadata {
    values = {filename = "", stream = ""}
  }
  forward_to = [loki.process.space.receiver]
}
{{ end }}
{{- if .Values.collection.journal.enabled }}
{{- $journal := .Values.collection.journal }}
{{- /* A release from before sidecars existed reuses values without them. */}}
{{- $sidecars := $journal.sidecars | default dict }}
loki.relabel "journal" {
  forward_to = []
  // A line is kept when keepRegex matches its "unit;identifier". A sandbox's
  // sidecars have no unit: they run in the sandbox's cgroup and inherit the
  // runtime supervisor's output, so they are kept by that cgroup instead,
  // except on excluded hosts. Each match marks the line; the source drops
  // the `__` mark with the other internal labels.
  rule {
    source_labels = ["__journal__systemd_unit", "__journal_syslog_identifier"]
    regex = {{ $journal.keepRegex | quote }}
    target_label = "__tmp_journal_keep"
    replacement = "1"
  }
{{- if $sidecars.enabled }}
  rule {
    source_labels = ["__journal__systemd_unit", "__journal__systemd_cgroup"]
    regex = {{ printf ";(?:%s)" $sidecars.cgroupRegex | quote }}
    target_label = "__tmp_journal_keep"
    replacement = "1"
  }
{{- end }}
  rule {
    source_labels = ["__tmp_journal_keep"]
    regex = "1"
    action = "keep"
  }
{{- if and $sidecars.enabled $sidecars.excludedHosts }}
{{- $hosts := list }}
{{- range $sidecars.excludedHosts }}
{{- $hosts = append $hosts (regexQuoteMeta .) }}
{{- end }}
  rule {
    source_labels = ["__journal__systemd_unit", "__journal__systemd_cgroup", "__journal__hostname"]
    regex = {{ printf ";%s;(?:%s)" $sidecars.cgroupRegex (join "|" $hosts) | quote }}
    action = "drop"
  }
{{- end }}
{{- with .Values.collection.journal.dropRegex }}
  rule {
    source_labels = ["__journal__systemd_unit", "__journal_syslog_identifier"]
    regex = {{ . | quote }}
    action = "drop"
  }
{{- end }}
  rule {
    source_labels = ["__journal_syslog_identifier"]
    target_label = "service"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label = "unit"
  }
}
loki.source.journal "host" {
  path = {{ .Values.collection.journal.path | quote }}
  max_age = {{ .Values.collection.journal.maxAge | quote }}
  format_as_json = false
  relabel_rules = loki.relabel.journal.rules
  labels = {log_source = "journal", namespace = "host", node = sys.env("NODE_NAME"), cluster = {{ .Values.clusterLabel | quote }}}
  forward_to = [loki.process.space.receiver]
}
{{- end }}

loki.process "space" {
  // Extraction changes labels only. Never rewrite/re-serialize the JSON line.
  stage.json {
    expressions = {service = "service", environment = "env", cluster = "cluster_id", event_time = "timestamp"}
  }
  // A label is set only from a value the line carries, so a container's
  // fallback `service` stays when the line has none.
  stage.labels {
    values = {service = "", environment = "", cluster = ""}
  }
  stage.timestamp {
    source = "event_time"
    format = "RFC3339Nano"
    action_on_failure = "skip"
  }
  stage.structured_metadata {
    values = {unit = ""}
  }
  // No pod IDs, sandbox/request IDs, versions, filenames or arbitrary JSON labels.
  stage.label_keep {
    values = ["service", "environment", "cluster", "namespace", "log_source", "node"]
  }
  forward_to = [loki.write.local.receiver{{ if .Values.validationEcho }}, loki.echo.validation.receiver{{ end }}]
}
{{ if .Values.validationEcho }}
loki.echo "validation" {}
{{ end }}
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
    batch_wait = "1s"
    batch_size = "256KiB"
    remote_timeout = "5s"
    min_backoff_period = "500ms"
    max_backoff_period = "5s"
    max_backoff_retries = 5
  }
}
